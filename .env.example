# Database
DATABASE_URL=postgresql://user:pass@host.neon.tech/airtomic_creative?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=airtomic-creative
R2_PUBLIC_BASE=https://media.example.com

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_API_VERSION=v21.0

# Modal (WhisperX)
MODAL_TRANSCRIBE_URL=
MODAL_TOKEN=

# Hugging Face — needed for pyannote diarisation.
# Accept terms for BOTH pyannote/speaker-diarization-3.1 AND
# pyannote/segmentation-3.0 under the account owning this token.
HF_TOKEN=

# Vision tagging
ANTHROPIC_API_KEY=

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
